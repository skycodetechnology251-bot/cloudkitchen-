{
  "expo": {
    "name": "Daily Table Rider",
    "slug": "daily-table-rider",
    "scheme": "dailytablerider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F5FA8"
    },
    "ios": {
      "bundleIdentifier": "in.dailytable.rider",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "While you are on duty, Daily Table shares your location with the kitchen so it can assign nearby deliveries."
      }
    },
    "android": {
      "package": "in.dailytable.rider",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1F5FA8"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While you are on duty, Daily Table shares your location with the kitchen so it can assign nearby deliveries."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F5FA8"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://wownaturals.in",
      "eas": {
        "projectId": ""
      }
    }
  }
}