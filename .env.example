# Daily Table settings. You don't need to edit this: open https://your-domain/install and the
# setup page writes .env for you (database, admin, https). Keys for Razorpay, SMS, WhatsApp, push,
# email, Google and OpenAI can be entered later in Admin → Integrations.
APP_NAME="Daily Table"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wownaturals.in
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Filled in by the setup page.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Files until setup finishes; the setup page switches these to the database.
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email: a mailbox from your hosting panel (Email Accounts).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=hello@wownaturals.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@wownaturals.in
MAIL_FROM_NAME="Daily Table"

# GST and ordering
APP_BRAND="Daily Table"
GST_RATE=5
GST_INCLUSIVE=false
GST_SAC=996331
GST_PLACE_OF_SUPPLY="Tamil Nadu (33)"
INVOICE_PREFIX=DT
DELIVERY_FEE_PAISE=2000

# Optional here (better: Admin → Integrations, stored encrypted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_IDS=
# Google sign-in for the website AND both apps (or set them in Admin → Integrations → Google sign-in)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
SMS_DRIVER=log
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=DLYTBL
SMS_OTP_TEMPLATE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mobile apps (mobile/customer, mobile/rider) use these same settings: Laravel writes them to
# mobile/app-config.json. Easier: Admin → Integrations → Mobile apps.
MOBILE_CUSTOMER_NAME="Daily Table"
MOBILE_CUSTOMER_PACKAGE=in.dailytable.app
MOBILE_RIDER_NAME="Daily Table Rider"
MOBILE_RIDER_PACKAGE=in.dailytable.rider
MOBILE_VERSION=1.0.0
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
EXPO_PROJECT_ID=

# Testing only: these numbers log in with this code (never set on a live site).
OTP_TEST_NUMBERS=
OTP_TEST_CODE=

# Background tasks after page visits when there is no cron job (true/false).
DAILYTABLE_WEB_CRON=true
